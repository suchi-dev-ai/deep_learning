    "def  get_top_k_predictions(image_embeds, text_embeds, k=3):\n",
    "    # Compute similarity\n",
    "    logits = image_embeds @ text_embeds.T\n",
    "    top_k_indices = torch.topk(logits, k, dim=1).indices\n",
    "    return top_k_indices.cpu().numpy()\n",
    "# Example usage of get_top_k_predictions\n",
    "image_embeds = get_image_embeddings(pixel_values)\n",
    "text_embeds = get_text_embeddings(CLASS_NAMES)\n",
    "# Example usage of get_top_k_predictions\n",
    "top_k_predictions = get_top_k_predictions(image_embeds, text_embeds, k=3)\n",
    "print(\"Top K Predictions:\", top_k_predictions)"
   ]
